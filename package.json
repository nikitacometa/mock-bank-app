{
  "name": "cometa-bank",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:web && pnpm build:bot",
    "build:web": "tsc -b && vite build",
    "build:bot": "tsc -p tsconfig.bot.json",
    "preview": "vite preview",
    "start:bot": "node --enable-source-maps bot/dist/main.js",
    "test": "pnpm test:web && pnpm test:bot",
    "test:web": "vitest run",
    "test:bot": "vitest run --config bot/vitest.config.ts",
    "test:watch": "vitest",
    "lint": "eslint src bot",
    "check:css": "bash scripts/check-css-guards.sh",
    "check:deploy": "bash scripts/check-deploy.sh",
    "verify": "pnpm lint && pnpm check:css && pnpm check:deploy && pnpm test && pnpm build"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@tma.js/sdk-react": "3.0.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "20.0.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
